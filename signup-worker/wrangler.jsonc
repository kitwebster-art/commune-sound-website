{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commune-sound-signup",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://communesound.com.au,https://www.communesound.com.au",
    "TURNSTILE_HOSTNAMES": "communesound.com.au,www.communesound.com.au",
    "WELCOME_FROM": "Commune Sound <hello@communesound.com.au>",
    "WELCOME_REPLY_TO": "studio@kitwebster.com"
  },
  "ratelimits": [
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "HUMANITIX_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
